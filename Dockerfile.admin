FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

COPY ["src/ApexCommerce.Domain/ApexCommerce.Domain.csproj", "src/ApexCommerce.Domain/"]
COPY ["src/ApexCommerce.Application/ApexCommerce.Application.csproj", "src/ApexCommerce.Application/"]
COPY ["src/ApexCommerce.Infrastructure/ApexCommerce.Infrastructure.csproj", "src/ApexCommerce.Infrastructure/"]
COPY ["src/ApexCommerce.Admin.Blazor/ApexCommerce.Admin.Blazor.csproj", "src/ApexCommerce.Admin.Blazor/"]

RUN dotnet restore "src/ApexCommerce.Admin.Blazor/ApexCommerce.Admin.Blazor.csproj"

COPY src/ src/
WORKDIR "/app/src/ApexCommerce.Admin.Blazor"
RUN dotnet publish "ApexCommerce.Admin.Blazor.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ApexCommerce.Admin.Blazor.dll"]

